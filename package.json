{
  "name": "jubla-reporting",
  "version": "0.10.0",
  "description": "Jubla Wald ZH – Reporting Tool",
  "scripts": {
    "dev": "npm run build:web && netlify dev",
    "build": "node update-version.js",
    "build:web": "bash scripts/build-web.sh",
    "test:backend": "node --test \"backend/functions/lib/*.test.js\"",
    "test": "npm run test:backend && cd app && flutter analyze && flutter test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "@netlify/functions": "6.0.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "netlify-cli": "27.16.0",
    "prettier": "3.9.10"
  }
}

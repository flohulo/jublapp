# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEET_ID=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----\n"
SHEET_NAME=
GOOGLE_DRIVE_FOLDER_ID=

# App login
PIN=
# Zum Signieren der Sitzungs-Token, mind. 32 Zeichen, zufällig (z. B. mit: openssl rand -hex 32).
# Ohne dieses Geheimnis ist kein Login möglich.
SESSION_SECRET=

# Gmail API
SMTP_USER=
SMTP_PASS=

# Empfänger der Mails
SCHARLEITUNG_EMAIL=

#Support
SCHAR_EMAIL=
SUPPORT_PHONE=

# Optional: Origin, die die API per CORS aufrufen darf (z. B. http://localhost:8080
# für die lokale Entwicklung). Leer lassen: keine fremde Origin erlaubt, die
# Web-App läuft auf derselben Origin wie die API. Ein "*" wird ignoriert.
ALLOWED_ORIGIN=
